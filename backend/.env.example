# Contoh saja. Aplikasi membaca environment proses, bukan file .env secara otomatis.
PORT=8080
APP_ENV=development
# Kosongkan/hilangkan DB_URL dan JDBC_DATABASE_URL untuk fallback H2 file lokal.
# DB_URL=jdbc:postgresql://localhost:5432/ecoloop
# JDBC_DATABASE_URL=postgresql://username:password@localhost:5432/ecoloop
# DB_USER=ecoloop
# DB_PASSWORD=isi-lewat-secret-manager
# JWT_SECRET wajib >= 32 karakter di production; jangan commit secret asli.
# JWT_SECRET=
JWT_ISSUER=ecoloop
JWT_AUDIENCE=ecoloop-android
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
